{
  "manifest_version": 3,
  "name": "Margin PDF",
  "version": "0.1.0",
  "description": "Read PDFs with instant link previews, independent split panes, search, and a focused reading interface.",
  "minimum_chrome_version": "151",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Open Margin PDF",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "welcome.html?settings=1",
    "open_in_tab": true
  },
  "mime_types_handler": {
    "application/pdf": {
      "handler_url": "viewer.html",
      "can_embed": true
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'; frame-src 'none'"
  },
  "homepage_url": "https://github.com/nmoynihan/margin-pdf"
}
